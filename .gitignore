# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# netlify（本地构建产物与函数包，体积大且无需入库，云端重新生成）
/.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts

# 示例内容本地备份（不提交到公开仓库）
/posts_backup/
/moments_backup/

# 写作台草稿（仅本机，不进入时间线、不提交）
/drafts/

# 本地工具脚本产物（如需提交可移除下一行）
generate-albums.ps1
